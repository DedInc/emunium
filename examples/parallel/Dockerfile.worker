# examples/parallel/Dockerfile.worker
# One headed emunium worker: Debian's Chromium on its own Xvfb display with
# openbox, driven by worker.py through real X11 input. Every container is one
# desktop, so containers run side by side without sharing a mouse or keyboard.
#
# Build context is the repository root (docker-compose.yml sets it):
#   docker compose -f examples/parallel/docker-compose.yml build
# This installs the checkout in the context. To install a released version
# from PyPI instead, pass the requirement as a build argument:
#   docker compose -f examples/parallel/docker-compose.yml build \
#       --build-arg EMUNIUM_PACKAGE="emunium==3.1.0"
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Same desktop as tests/docker/Dockerfile: Xvfb + openbox + Chromium.
# DejaVu covers Latin and Cyrillic, Noto CJK and colour emoji the rest.
# libx11-6/libxtst6 are what emunium's X11 backend loads through ctypes;
# xclip is pyperclip's clipboard on X11 (control characters only on Linux).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        xvfb openbox chromium \
        fonts-dejavu-core fonts-noto-cjk fonts-noto-color-emoji \
        libx11-6 libxtst6 xclip \
    && rm -rf /var/lib/apt/lists/*

# Docker Desktop runs containers on a WSL2 kernel, and pyperclip then picks
# the Windows clipboard (clip.exe) before looking at DISPLAY; pin it to X11.
RUN printf '%s\n' \
        '# Pin pyperclip to X11 (see examples/parallel/Dockerfile.worker).' \
        'try:' \
        '    import pyperclip' \
        '    pyperclip.set_clipboard("xclip")' \
        'except ImportError:' \
        '    pass' \
        > "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/sitecustomize.py"

# Debian's Chromium opens its search engine's start page as the first tab; a
# blank one keeps startup off the network.
RUN mkdir -p /etc/chromium/policies/managed \
    && printf '{"NewTabPageLocation": "about:blank"}\n' \
        > /etc/chromium/policies/managed/emunium-worker.json

# Xvfb runs as the non-root user and cannot create the socket directory itself.
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Match WORKER_UID to the host user that owns ./results on a Linux host
# (--build-arg WORKER_UID="$(id -u)"); Docker Desktop does not need it.
ARG WORKER_UID=1000
RUN useradd --create-home --shell /bin/bash --uid "${WORKER_UID}" worker

# Only the package and its metadata are copied: BuildKit transfers just the
# paths used here, not the rest of the repository.
COPY pyproject.toml README.md LICENSE /src/
COPY emunium /src/emunium
ARG EMUNIUM_PACKAGE=/src
RUN pip install "${EMUNIUM_PACKAGE}" && rm -rf /src

WORKDIR /app
COPY examples/parallel/worker.py examples/parallel/entrypoint.sh /app/
# A Windows checkout may carry CRLF line endings, which break the shebang.
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod 0755 /app/entrypoint.sh \
    && mkdir -p /results && chown worker:worker /results

USER worker

ENV EMUNIUM_CHROME_PATH=/usr/bin/chromium \
    DISPLAY_NUM=99 \
    SCREEN_GEOMETRY=1920x1080x24 \
    JOB_FILE=/jobs/example.json \
    RESULTS_DIR=/results

ENTRYPOINT ["/app/entrypoint.sh"]
